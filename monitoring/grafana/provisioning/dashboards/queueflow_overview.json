      "id": 1,
      "type": "timeseries",
      "title": "Job Submission Rate (per second)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(queueflow_jobs_submitted_total[5m])",
          "legendFormat": "__auto",
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          }
        }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "line" } },
        "overrides": []
